# 브라우저(src/js/config.js CONFIG)에 넣어도 되는 공개 값. 실제 값은 여기에 커밋하지 않는다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 카카오맵 JavaScript 키 — 지도 렌더링 전용 공개 키.
# 카카오 개발자 콘솔 > 앱 설정 > 플랫폼 > Web 에 배포 도메인을 등록해 다른 사이트에서 못 쓰게 막는다.
# (등록 예: https://junyeong-nero.github.io · http://localhost:8000)
KAKAO_JS_KEY=

# Edge Function 설정값 (supabase secrets set 으로 등록). 아래 값들은 서버 전용이라 브라우저·HTML에 절대 넣지 않는다.
OPENROUTER_MODEL=openrouter/free
DEMO_MODE=true
# 카카오 REST(서버) 키 — 장소 검색 API 전용. 브라우저에 노출되면 안 되므로 Edge Function 비밀값으로만 등록한다.
KAKAO_REST_KEY=
